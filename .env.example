# MasterDriver — przykład zmiennych środowiskowych
# Skopiuj do .env i uzupełnij realnymi wartościami przed publikacją.
# UWAGA: obecnie kod trzyma te wartości na sztywno w src/app.jsx (BUY_URL, klucz testowy).
# Docelowo warto przenieść je tutaj i czytać przez import.meta.env.VITE_*.

# Realny link produktu Lemon Squeezy (zastępuje BUY_URL w app.jsx)
VITE_BUY_URL=https://masterdriver.lemonsqueezy.com/buy/PODMIEN-NA-REALNY-LINK

# ── Franek (backend uwag) ──────────────────────────────────────────────
# Franek synchronizuje uwagi kierowców do /api/feedback (Upstash Redis).
# Na Vercel: Storage → Upstash Redis (lub KV) wstrzykuje te dwie zmienne automatycznie.
# Kod czyta oba nazewnictwa (UPSTASH_* albo KV_*), więc wystarczy jedna integracja.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Token do podglądu uwag przez /api/feedback-admin?token=...  (wymyśl długi losowy ciąg)
FEEDBACK_ADMIN_TOKEN=
